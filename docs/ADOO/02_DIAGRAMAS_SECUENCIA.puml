@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title CU-02 — Ataque del jugador
actor Jugador
participant "WaifuGameFrame" as View
participant "AnimeGameFacade" as Facade
participant "CombatStrategy" as Strategy
participant "Waifu" as Target
participant "Observer" as Obs

Jugador -> View : selecciona atacante y objetivo
Jugador -> View : presiona ATACAR
View -> Facade : fight(atacante, objetivo, strategy)
Facade -> Strategy : calculateDamage(atacante, objetivo)
Strategy --> Facade : daño
Facade -> Target : receiveDamage(daño)
Target -> Target : updateStateFromHp()
Target -> Obs : notify(evento)
Obs --> View : actualización del registro
Facade --> View : daño
View -> View : actualiza interfaz
@enduml

@startuml
!theme plain
skinparam sequenceMessageAlign center

title CU-03 — Uso de habilidad especial
actor Jugador
participant "WaifuGameFrame" as View
participant "Waifu" as Waifu
participant "SpecialAbility" as Ability
participant "Observer" as Obs

Jugador -> View : selecciona waifu
Jugador -> View : presiona HABILIDAD
View -> Waifu : useAbility(target)
Waifu -> Ability : activate(user, target)
Ability --> Waifu : resultado
Waifu -> Waifu : abilityUsed = true
Waifu -> Obs : notify(evento)
Obs --> View : registra evento
Waifu --> View : descripción del efecto
View -> View : refresca ATK/DEF/HP
@enduml

@startuml
!theme plain
skinparam sequenceMessageAlign center

title CU-04 — Turno del oponente
participant "WaifuGameFrame" as View
participant "Enemy Combat Policy" as Policy
participant "AnimeGameFacade" as Facade
participant "CombatStrategy" as Strategy
participant "Enemy Waifu" as Enemy
participant "Ally Waifu" as Ally

View -> Policy : chooseEnemyAttacker(enemies)
Policy --> View : enemiga con mayor ATK
View -> Policy : chooseEnemyTarget(allies)
Policy --> View : aliada con menor HP
View -> Facade : fight(enemy, ally, strategy)
Facade -> Strategy : calculateDamage(enemy, ally)
Strategy --> Facade : daño
Facade -> Ally : receiveDamage(daño)
Ally --> View : estado actualizado
View -> View : incrementa turno y guarda combate
@enduml
